generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Currency {
  ARS
  USD
}

enum TransactionType {
  BUY
  SELL
}

// ---------------------------------------------------------------------------
// Auth models (Better Auth — tables already created via migration)
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  sessions           Session[]
  accounts           Account[]
  portfolioSnapshots PortfolioSnapshot[]
  transactions       Transaction[]
  dividends          Dividend[]
  retirementSettings RetirementSettings[]
  targetAllocations  TargetAllocation[]
  milestoneAlerts    MilestoneAlert[]
  portfolioReports   PortfolioReport[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ---------------------------------------------------------------------------
// PortfolioSnapshot
//
// Representa el estado del portfolio en un momento específico del tiempo.
// Se crea importando un CSV exportado desde Cocos Capital.
// Es inmutable: una vez creado no debe modificarse.
// ---------------------------------------------------------------------------

model PortfolioSnapshot {
  id            String     @id @default(cuid())
  snapshotDate  DateTime   @db.Date
  totalValueArs Decimal    @db.Decimal(18, 2)
  totalValueUsd Decimal?   @db.Decimal(18, 2)
  ccl           Decimal?   @db.Decimal(10, 4)
  sourceFile    String?
  positions     Position[]
  createdAt     DateTime   @default(now())
  userId        String?
  user          User?      @relation(fields: [userId], references: [id])

  @@unique([userId, snapshotDate])
  @@index([snapshotDate])
  @@map("portfolio_snapshots")
}

// ---------------------------------------------------------------------------
// Position
//
// Representa la tenencia de un activo específico dentro de un snapshot.
// Cada posición pertenece a un único snapshot.
// allocationPct se almacena desnormalizado para reproducibilidad histórica.
// ---------------------------------------------------------------------------

model Position {
  id             String            @id @default(cuid())
  snapshotId     String
  snapshot       PortfolioSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  ticker         String
  instrumentName String?
  quantity       Decimal           @db.Decimal(18, 8)
  price          Decimal           @db.Decimal(18, 4)
  currency       Currency          @default(ARS)
  positionValue  Decimal           @db.Decimal(18, 2)
  allocationPct  Decimal           @db.Decimal(8, 6)
  createdAt      DateTime          @default(now())

  @@unique([snapshotId, ticker])
  @@index([snapshotId])
  @@index([ticker])
  @@map("positions")
}

// ---------------------------------------------------------------------------
// Asset
//
// Tabla de referencia mutable para los CEDEARs.
// Almacena el cedearRatio necesario para convertir entre precio en ARS y USD.
// No tiene FK desde Position para evitar rigidez al importar nuevos tickers.
// Los ratios rara vez cambian pero pueden actualizarse cuando sea necesario.
// ---------------------------------------------------------------------------

model Asset {
  id               String   @id @default(cuid())
  ticker           String   @unique
  instrumentName   String?
  cedearRatio      Decimal  @db.Decimal(8, 4)
  description      String?
  sector           String?
  industry         String?
  country          String?
  underlyingTicker String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ticker])
  @@map("assets")
}

// ---------------------------------------------------------------------------
// ExchangeRate
//
// Almacena el historial de la tasa CCL (Contado con Liquidación) por fecha.
// Desacoplado de los snapshots para registrar tasas independientemente.
// Permite calcular el valor del portfolio en USD: valor_ars / ccl.
// ---------------------------------------------------------------------------

model ExchangeRate {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  ccl       Decimal  @db.Decimal(10, 4)
  source    String?
  createdAt DateTime @default(now())

  @@index([date])
  @@map("exchange_rates")
}

// ---------------------------------------------------------------------------
// MarketPriceCache
//
// Cache de precios de mercado en tiempo real para cada ticker subyacente.
// Se actualiza periódicamente via API externa (Yahoo Finance).
// ---------------------------------------------------------------------------

model MarketPriceCache {
  id        String   @id @default(cuid())
  ticker    String   @unique
  price     Decimal  @db.Decimal(18, 4)
  currency  Currency @default(USD)
  fetchedAt DateTime @default(now())

  @@index([ticker])
  @@map("market_price_cache")
}

// ---------------------------------------------------------------------------
// BenchmarkPoint
//
// Datos históricos de benchmarks externos (S&P 500, Merval, etc.)
// para comparar contra la performance del portfolio.
// ---------------------------------------------------------------------------

model BenchmarkPoint {
  id          String   @id @default(cuid())
  benchmarkId String
  date        DateTime @db.Date
  value       Decimal  @db.Decimal(18, 6)

  @@unique([benchmarkId, date])
  @@index([benchmarkId, date])
  @@map("benchmark_points")
}

// ---------------------------------------------------------------------------
// TargetAllocation
//
// Asignación objetivo por ticker para la función de rebalanceo.
// Se compara contra la asignación real del snapshot más reciente.
// ---------------------------------------------------------------------------

model TargetAllocation {
  id        String   @id @default(cuid())
  ticker    String   @unique
  targetPct Decimal  @db.Decimal(8, 6)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@map("target_allocations")
}

// ---------------------------------------------------------------------------
// Transaction
//
// Registro de operaciones de compra/venta de CEDEARs.
// Permite calcular el precio promedio de compra (PPM) y P&L realizadas.
// ---------------------------------------------------------------------------

model Transaction {
  id        String          @id @default(cuid())
  ticker    String
  type      TransactionType
  quantity  Decimal         @db.Decimal(18, 8)
  price     Decimal         @db.Decimal(18, 4)
  currency  Currency        @default(ARS)
  fee       Decimal?        @db.Decimal(18, 2)
  date      DateTime        @db.Date
  notes     String?
  createdAt DateTime        @default(now())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id])

  @@index([ticker])
  @@index([date])
  @@map("transactions")
}

// ---------------------------------------------------------------------------
// Dividend
//
// Registro de dividendos cobrados por ticker.
// Se puede incluir (toggle) al calcular el rendimiento total en /performance.
// ---------------------------------------------------------------------------

model Dividend {
  id        String   @id @default(cuid())
  ticker    String
  amount    Decimal  @db.Decimal(18, 4)
  currency  Currency @default(USD)
  date      DateTime @db.Date
  notes     String?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([ticker])
  @@index([date])
  @@map("dividends")
}

// ---------------------------------------------------------------------------
// RetirementSettings
//
// Configuración personal para la calculadora de jubilación.
// Un único registro (upsert por id fijo "default").
// ---------------------------------------------------------------------------

model RetirementSettings {
  id                  String   @id @default(cuid())
  currentAge          Int
  retirementAge       Int
  monthlyExpensesUsd  Decimal  @db.Decimal(18, 2)
  inflationRate       Decimal  @db.Decimal(6, 4)
  withdrawalRate      Decimal  @db.Decimal(6, 4)
  monthlyContribution Decimal  @db.Decimal(18, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  userId              String?
  user                User?    @relation(fields: [userId], references: [id])

  @@map("retirement_settings")
}

// ---------------------------------------------------------------------------
// HistoricalPriceCache
//
// Cache de precios históricos diarios en USD para cada ticker subyacente.
// Usado para calcular la ganancia real en USD y el impacto del CCL.
// Patrón idéntico a BenchmarkPoint.
// ---------------------------------------------------------------------------

model HistoricalPriceCache {
  id       String   @id @default(cuid())
  ticker   String
  date     DateTime @db.Date
  priceUsd Decimal  @db.Decimal(18, 4)

  @@unique([ticker, date])
  @@index([ticker])
  @@map("historical_price_cache")
}

// ---------------------------------------------------------------------------
// MilestoneAlert
//
// Hitos de valor del portfolio (en USD) que el usuario quiere celebrar.
// Se verifica automáticamente al importar un nuevo snapshot.
// ---------------------------------------------------------------------------

model MilestoneAlert {
  id             String    @id @default(cuid())
  label          String
  targetValueUsd Decimal   @db.Decimal(18, 2)
  reached        Boolean   @default(false)
  reachedAt      DateTime?
  createdAt      DateTime  @default(now())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id])

  @@map("milestone_alerts")
}

// ---------------------------------------------------------------------------
// InvestmentStrategy
//
// Almacena versiones inmutables de la estrategia de inversión en CEDEARs.
// Solo una versión puede estar activa a la vez (isActive = true).
// Nunca se modifica un registro existente — cada cambio crea uno nuevo.
// Se usa como system prompt al llamar a Claude en analyze-portfolio.
// ---------------------------------------------------------------------------

model InvestmentStrategy {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  isActive  Boolean  @default(false)
  version   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("investment_strategies")
}

// ---------------------------------------------------------------------------
// PortfolioReport
//
// Guarda cada análisis mensual generado por Claude a partir de un PDF de
// Cocos Capital. Permite consultar el historial de reportes en producción
// sin depender del sistema de archivos (que es efímero en Vercel).
// ---------------------------------------------------------------------------

model PortfolioReport {
  id             String   @id @default(cuid())
  fechaReporte   String
  rawText        String
  normalizedJson Json
  createdAt      DateTime @default(now())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@map("portfolio_reports")
}

